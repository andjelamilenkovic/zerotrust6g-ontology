    <!-- http://www.elfak.ni.ac.rs/zerotrust6g#CompromisedAgent -->

    <owl:Class rdf:about="http://www.elfak.ni.ac.rs/zerotrust6g#CompromisedAgent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.elfak.ni.ac.rs/zerotrust6g#AutonomousAgent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.elfak.ni.ac.rs/zerotrust6g#operatesAt"/>
                        <owl:someValuesFrom rdf:resource="http://www.elfak.ni.ac.rs/zerotrust6g#EdgeLayer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.elfak.ni.ac.rs/zerotrust6g#trustValue"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.elfak.ni.ac.rs/zerotrust6g#AutonomousAgent"/>
    </owl:Class>
    


