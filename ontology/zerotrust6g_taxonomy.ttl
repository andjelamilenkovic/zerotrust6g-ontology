#    Individuals
#################################################################

###  http://www.elfak.ni.ac.rs/zerotrust6g#CompromisedAgent_002
:CompromisedAgent_002 rdf:type owl:NamedIndividual ,
                               :AutonomousAgent ;
                      :operatesAt :EdgeLayer_001 ;
                      :trustValue 0.15 .


###  http://www.elfak.ni.ac.rs/zerotrust6g#EdgeLayer_001
:EdgeLayer_001 rdf:type owl:NamedIndividual ,
                        :EdgeLayer .


###  http://www.elfak.ni.ac.rs/zerotrust6g#Goal_MonitorPatient
:Goal_MonitorPatient rdf:type owl:NamedIndividual ,
                              :Goal .


###  http://www.elfak.ni.ac.rs/zerotrust6g#MonitoringAgent_001
:MonitoringAgent_001 rdf:type owl:NamedIndividual ,
                              :AutonomousAgent ;
                     :pursues :Goal_MonitorPatient .


###  http://www.elfak.ni.ac.rs/zerotrust6g#UnauthAgent_005
:UnauthAgent_005 rdf:type owl:NamedIndividual ,
